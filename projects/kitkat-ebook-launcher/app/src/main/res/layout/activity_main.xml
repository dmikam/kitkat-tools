<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Top title bar removed per user request -->

    <!-- Navigation Tabs with inline shortcut icons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="@color/white">

        <Button
            android:id="@+id/tab_books"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/tab_books"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:background="@color/black" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/gray_border" />

        <Button
            android:id="@+id/tab_apps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/tab_apps"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:background="@color/white" />

        <!-- small divider before icon buttons -->
        <View
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <!-- Right-aligned icon shortcuts -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btn_file_manager"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="Open file manager"
                    android:src="@android:drawable/ic_menu_save" />

                <ImageButton
                    android:id="@+id/btn_browser"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="Open browser"
                    android:src="@android:drawable/ic_menu_compass" />

                <ImageButton
                    android:id="@+id/btn_refresh_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/refresh"
                    android:src="@android:drawable/ic_menu_rotate" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/black" />

    <!-- Main Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Books View -->
        <LinearLayout
            android:id="@+id/container_books"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_empty_books"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/no_books_found"
                android:textColor="@color/gray_dark"
                android:textSize="16sp"
                android:visibility="gone" />

            <ListView
                android:id="@+id/lv_books"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:fadingEdge="none"
                android:cacheColorHint="@color/white" />

        </LinearLayout>

        <!-- Apps View -->
        <LinearLayout
            android:id="@+id/container_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_empty_apps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/no_apps_found"
                android:textColor="@color/gray_dark"
                android:textSize="16sp"
                android:visibility="gone" />

            <GridView
                android:id="@+id/gv_apps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:numColumns="4"
                android:verticalSpacing="12dp"
                android:horizontalSpacing="8dp"
                android:padding="12dp"
                android:stretchMode="columnWidth"
                android:gravity="center"
                android:fadingEdge="none"
                android:cacheColorHint="@color/white" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>

