<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/tv_cache_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thumbnails cache: —"
        android:textSize="16sp"
        android:textColor="@color/black" />

    <Button
        android:id="@+id/btn_clear_cache"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Clear thumbs cache" />

    <CheckBox
        android:id="@+id/chk_show_covers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Show covers in list" />

    <CheckBox
        android:id="@+id/chk_auto_load_covers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Automatically load covers in background" />

</LinearLayout>
